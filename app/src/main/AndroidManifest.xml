<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      默认不申请 INTERNET 权限：内容全部离线打包，只有用户主动点「查看原始来源」
      时才通过 CustomTabs 交给系统浏览器处理，本 App 自身始终无网络能力。
    -->

    <!-- 每日记录提醒。Android 13+ 需运行时申请；用户拒绝时 App 功能不受影响。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      精确提醒（可选，默认关）：只有用户在设置里显式开启「准点提醒」且系统授权后才使用；
      权限被收回时自动回落到不精确的 WorkManager 提醒，不会静默失效。
      刻意不申请 USE_EXACT_ALARM：那是闹钟/日历类应用专用，记录提醒不属于该场景。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 精确闹钟在重启后会丢失（WorkManager 周期任务由系统自行恢复），开机后需重排一次。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AnchorApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anchor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Anchor"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          精确提醒触发与开机重排。BOOT_COMPLETED 是受保护广播（仅系统可发），
          因此 exported=false 既够用也最小暴露。
        -->
        <receiver
            android:name=".notify.ExactReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
